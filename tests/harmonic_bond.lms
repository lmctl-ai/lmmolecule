# Harmonic bond dimer: exact oscillation period T = 2*pi*sqrt(mu/k),
# quarter/half/full-period phase checks, force verification, and Verlet energy conservation.
out = ARGV.len() > 0 ? ARGV[0] : "build/harmonic_bond.dslb";
p = _dsl_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
# Two equal masses m1 = m2 = 2.0 amu -> reduced mass mu = m1*m2/(m1+m2) = 1.0 amu.
# With k = 4*pi^2 = 39.47841760435743 kJ/(mol*nm^2), omega = sqrt(k/mu) = 2*pi rad/ps -> period T = 1.0 ps.
md.platform("reference");
let k = md.eval("4 * pi^2");
let r0 = 0.20;
let amp = 0.05;
let sys = md.system();
let i0 = sys.particle(2.0);
let i1 = sys.particle(2.0);
sys.pos(0, -0.125, 0.0, 0.0).pos(1, 0.125, 0.0, 0.0);
md.assert_close(float(i0), 0.0, 0.0);
md.assert_close(float(i1), 1.0, 0.0);
md.assert_close(float(sys.count()), 2.0, 0.0);
sys.bond(0, 1, r0, k);

# Initial state at r(0) = 0.25 nm, v(0) = 0:
# PE(0) = 0.5 * k * amp^2 = 0.04934802200544679 kJ/mol, F_x(1) = -k * amp = -1.9739208802178716 kJ/(mol*nm).
let sim = sys.sim("verlet", 0.0001, 0.0, 0.0, 1);
md.assert_close(sim.distance(0, 1), 0.25, 0.000000000001);
let e0 = 0.5 * k * amp * amp;
md.assert_close(sim.pe(), e0, 0.0000000001);
md.assert_close(sim.ke(), 0.0, 0.00000001);
md.assert_close(sim.energy(), e0, 0.00000001);
md.assert_close(sim.fx(0), k * amp, 0.000000001);
md.assert_close(sim.fx(1), -k * amp, 0.000000001);

# Quarter period t = 0.25 ps (2500 steps): bond crosses equilibrium r0 = 0.20 nm, PE -> 0, KE -> E0.
sim.step(2500);
md.assert_close(sim.time(), 0.25, 0.000000001);
md.assert_close(sim.distance(0, 1), r0, 0.0001);
md.assert_close(sim.pe(), 0.0, 0.00001);
md.assert_close(sim.ke(), e0, 0.00001);

# Half period t = 0.50 ps (5000 steps total): inner turning point r = r0 - amp = 0.15 nm.
sim.step(2500);
md.assert_close(sim.time(), 0.50, 0.000000001);
md.assert_close(sim.distance(0, 1), r0 - amp, 0.0001);
md.assert_close(sim.pe(), e0, 0.00001);
md.assert_close(sim.ke(), 0.0, 0.00001);

# Full period t = 1.00 ps (10000 steps total): outer turning point r = r0 + amp = 0.25 nm,
# relative energy drift |E(T) - E(0)| / E(0) < 1e-5.
sim.step(5000);
md.assert_close(sim.time(), 1.00, 0.000000001);
md.assert_close(sim.distance(0, 1), r0 + amp, 0.0001);
let drift = (sim.energy() - e0) / e0;
md.assert_close(drift, 0.0, 0.00001);
end _dsl_
savedsl(p, out);
