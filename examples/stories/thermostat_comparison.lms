# Thermostats compared: how 108 argon atoms started cold (20 K) reach a 120 K bath.
# NVE Verlet has no bath and keeps its own energy (the lattice potential energy feeds the kinetic
# energy, so T settles well below 120 K); the BAOAB Langevin integrator relaxes at the friction
# rate (1/ps and 10/ps); the Andersen thermostat re-draws velocities at the collision rate (10/ps)
# and shows the same approach with larger fluctuations.
mkdir("build/stories");
mkdir("docs/images");
sim_prog = _lmcode_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("cpu");
let bath = 120.0;
let nve = md.system().fcc(3, 0.54, 39.948).lj(0.996, 0.3405, 0.78).sim("verlet", 0.002, 0.0, 0.0, 1);
let weak = md.system().fcc(3, 0.54, 39.948).lj(0.996, 0.3405, 0.78).sim("langevin", 0.002, bath, 1.0, 2);
let strong = md.system().fcc(3, 0.54, 39.948).lj(0.996, 0.3405, 0.78).sim("langevin", 0.002, bath, 10.0, 3);
let andersen = md.system().fcc(3, 0.54, 39.948).lj(0.996, 0.3405, 0.78).andersen(bath, 10.0, 4).sim("verlet", 0.002, 0.0, 0.0, 4);
nve.velocities(20.0, 5);
weak.velocities(20.0, 5);
strong.velocities(20.0, 5);
andersen.velocities(20.0, 5);
md.print("time_ps,nve,langevin_1ps,langevin_10ps,andersen_10ps");
for (i in range(0, 151)) {
  md.print(str(0.02 * float(i)) + "," + str(nve.temperature()) + "," + str(weak.temperature()) + "," + str(strong.temperature()) + "," + str(andersen.temperature()));
  nve.step(10); weak.step(10); strong.step(10); andersen.step(10);
}
md.assert_close(strong.temperature(), bath, 40.0);
md.assert_close(andersen.temperature(), bath, 40.0);
end _lmcode_
savedsl(sim_prog, "build/stories/thermostat_comparison-sim.dslb");
r = system ${dsl_cli(sim_prog)} --dsl build/stories/thermostat_comparison-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);
write_file("build/stories/thermostats.csv", split(r.stdout, "{\"ok\"")[0]);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.cmd("set datafile separator ','");
plot.png("docs/images/thermostat_comparison.png", 900, 560);
plot.cmd("set title 'From 20 K towards a 120 K bath: NVE, Langevin and Andersen (108 argon atoms)'");
plot.cmd("set xlabel 'Time (ps)'; set ylabel 'Kinetic temperature (K)'; set grid; set key bottom right");
plot.cmd("set yrange [0:170]");
plot.cmd("set arrow from 0, 120 to 3, 120 nohead dt 2 lc rgb '#333333'");
plot.cmd("set label 'bath 120 K' at 0.05, 126 tc rgb '#333333' font ',10'");
plot.cmd("set label 'NVE: no bath; kinetic energy flows into the lattice potential' at 0.3, 3.5 tc rgb '#7f7f7f' font ',10'");
plot.cmd("plot 'build/stories/thermostats.csv' every ::1 using 1:2 with lines lw 2 lc rgb '#7f7f7f' title 'NVE Verlet', '' every ::1 using 1:3 with lines lw 2 lc rgb '#1f77b4' title 'Langevin, friction 1/ps', '' every ::1 using 1:4 with lines lw 2 lc rgb '#d62728' title 'Langevin, friction 10/ps', '' every ::1 using 1:5 with lines lw 2 lc rgb '#2ca02c' title 'Andersen, 10 collisions/ps'");
plot.close();
end _lmcode_
savedsl(draw, "build/stories/thermostat_comparison-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/stories/thermostat_comparison-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/thermostat_comparison.png");
