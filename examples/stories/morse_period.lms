# Anharmonic frequency shift: the period of a Morse bond grows with its energy.
# For V = De (1 - exp(-a (r - r0)))^2 the classical period is exactly T(E) = T0 / sqrt(1 - E/De),
# with T0 = 2 pi / (a sqrt(2 De / mu)) the harmonic period. The dimer is launched with increasing
# energy fractions E/De and the time between successive bond-length maxima is measured; a harmonic
# bond with the same curvature keeps T0 at every amplitude.
mkdir("build/stories");
mkdir("docs/images");
sim_prog = _dsl_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
let de = 120.0;
let a = 12.0;
let r0 = 0.16;
let mu = 1.0;
let t0 = md.eval("2 * pi / (12.0 * sqrt(2 * 120.0 / 1.0))");
md.print("fraction,morse_period_ps,harmonic_period_ps,exact_period_ps");
for (k in range(0, 9)) {
  let frac = 0.1 * float(k + 1);
  # Start at r0 with the kinetic energy that puts E/De at frac: KE = frac * De = 0.5 mu v_rel^2.
  let vrel = md.eval("sqrt(2 * " + str(frac * de) + " / " + str(mu) + ")");
  let morse = md.system().add_particle(2.0, -0.08, 0.0, 0.0).add_particle(2.0, 0.08, 0.0, 0.0)
    .custom_bond(0, 1, str(de) + "*(1 - exp(-" + str(a) + "*(r - " + str(r0) + ")))^2")
    .vel(0, -0.5 * vrel, 0.0, 0.0).vel(1, 0.5 * vrel, 0.0, 0.0);
  let harm = md.system().add_particle(2.0, -0.08, 0.0, 0.0).add_particle(2.0, 0.08, 0.0, 0.0)
    .bond(0, 1, r0, 2.0 * de * a * a)
    .vel(0, -0.5 * vrel, 0.0, 0.0).vel(1, 0.5 * vrel, 0.0, 0.0);
  let ms = morse.sim("verlet", 0.00002, 0.0, 0.0, 1);
  let hs = harm.sim("verlet", 0.00002, 0.0, 0.0, 1);
  # Period = time between the first two returns of the bond to r0 while stretching.
  let m_prev = ms.distance(0, 1);
  let m_cross = 0;
  let m_t1 = 0.0;
  let m_t2 = 0.0;
  let h_prev = hs.distance(0, 1);
  let h_cross = 0;
  let h_t1 = 0.0;
  let h_t2 = 0.0;
  for (i in range(0, 40000)) {
    ms.step(1);
    hs.step(1);
    let m_now = ms.distance(0, 1);
    let h_now = hs.distance(0, 1);
    if (m_prev < r0 && m_now >= r0) {
      m_cross = m_cross + 1;
      if (m_cross == 1) { m_t1 = ms.time(); }
      if (m_cross == 2) { m_t2 = ms.time(); }
    }
    if (h_prev < r0 && h_now >= r0) {
      h_cross = h_cross + 1;
      if (h_cross == 1) { h_t1 = hs.time(); }
      if (h_cross == 2) { h_t2 = hs.time(); }
    }
    m_prev = m_now;
    h_prev = h_now;
    if (m_cross >= 2 && h_cross >= 2) { break; }
  }
  let exact = t0 / md.eval("sqrt(1 - " + str(frac) + ")");
  md.print(str(frac) + "," + str(m_t2 - m_t1) + "," + str(h_t2 - h_t1) + "," + str(exact));
  md.assert_close(m_t2 - m_t1, exact, 0.01 * exact);
  md.assert_close(h_t2 - h_t1, t0, 0.01 * t0);
}
end _dsl_
savedsl(sim_prog, "build/stories/morse_period-sim.dslb");
r = system ${dsl_cli(sim_prog)} --dsl build/stories/morse_period-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);
write_file("build/stories/morse_period.csv", split(r.stdout, "{\"ok\"")[0]);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.cmd("set datafile separator ','");
plot.cmd("t0 = 2 * pi / (12.0 * sqrt(2 * 120.0)); exact(f) = t0 / sqrt(1 - f)");
plot.png("docs/images/morse_period.png", 900, 560);
plot.cmd("set title 'Morse vs harmonic bond: oscillation period against energy (De = 120 kJ/mol, mu = 1 amu)'");
plot.cmd("set xlabel 'Energy / De'; set ylabel 'Period (fs)'; set grid; set key top left");
plot.cmd("set xrange [0:1]; set yrange [30:115]");
plot.cmd("set label 'T(E) = T_0 / sqrt(1 - E/De)' at 0.42, 72 tc rgb '#d62728'");
plot.cmd("set label 'harmonic: T_0 = 33.8 fs at every amplitude' at 0.3, 38.5 tc rgb '#1f77b4' font ',10'");
plot.cmd("plot 1000 * exact(x) with lines lw 2 lc rgb '#d62728' title 'exact classical Morse period', 'build/stories/morse_period.csv' every ::1 using 1:(1000 * $2) with points pt 7 ps 1.5 lc rgb '#d62728' title 'measured, Morse bond (Verlet, 0.02 fs step)', '' every ::1 using 1:(1000 * $3) with points pt 5 ps 1.3 lc rgb '#1f77b4' title 'measured, harmonic bond with the same curvature', 1000 * t0 with lines dt 2 lc rgb '#1f77b4' notitle");
plot.close();
end _dsl_
savedsl(draw, "build/stories/morse_period-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/stories/morse_period-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/morse_period.png");
