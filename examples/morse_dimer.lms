# Anharmonic Morse diatomic oscillator via Lepton custom_bond:
# Integrates NVE Verlet dynamics and writes a thermodynamic report CSV.
mkdir("build/examples");
mkdir("docs/images");
out = ARGV.len() > 0 ? ARGV[0] : "build/morse_dimer.dslb";
p = _lmcode_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
let sys = md.system()
  .add_particle(2.0, -0.11, 0.0, 0.0)
  .add_particle(2.0, 0.11, 0.0, 0.0)
  .custom_bond(0, 1, "120.0*(1 - exp(-12.0*(r - 0.16)))^2");

let sim = sys.sim("verlet", 0.0002, 0.0, 0.0, 1);
let e0 = sim.energy();
sim.report("build/examples/morse.csv", 10).step(2000);
let e1 = sim.energy();
md.print("Morse oscillator initial/final energy (kJ/mol): " + str(e0) + " / " + str(e1));
md.assert_close((e1 - e0) / e0, 0.0, 0.0001);
end _lmcode_
savedsl(p, out);
# An explicit bytecode output argument retains compile-only use in test.sh.
if (ARGV.len() == 0) {
r = system ${dsl_cli(p)} --lmcode ${out};
assert(r.code == 0, r.stdout + r.stderr);

plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/morse_dimer.png", 900, 560);
plot.cmd("set title 'Morse dimer: conserved energy'; set xlabel 'Time (ps)'; set ylabel 'Energy (kJ/mol)'; set grid; set key outside top center horizontal");
plot.cmd("plot 'build/examples/morse.csv' using 2:5 with lines lw 2 lc rgb '#2ca02c' title 'total energy', '' using 2:3 with lines lw 1.5 lc rgb '#1f77b4' title 'kinetic', '' using 2:4 with lines lw 1.5 lc rgb '#d62728' title 'potential'");
plot.close();
end _lmcode_
savedsl(plot, "build/morse_dimer-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/morse_dimer-plot.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/morse_dimer.png");

}
