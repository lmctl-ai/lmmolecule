# Run from any working directory: lmscript examples/visual/nacl_structure.lms
# Molecular coordinates are computed by OpenMM, passed as CSV, then drawn by lmcad.
mkdir("build/visuals");
mkdir("docs/images");
compute = _lmcode_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
# Alternating charges in a rock-salt cell. Blue: Na+, green: Cl-; nm.
let sys = md.system().rocksalt(2, 0.564, 22.98977, 35.453, 1.0).coulomb("ewald", 0.5);
let sim = sys.sim("verlet", 0.001, 0.0, 0.0, 1);
md.assert_close(float(sys.count()), 64.0, 0.0);
md.print("t,x,y,z,r,g,b");
for (i in range(0, sys.count())) {
  # Each eight-site basis contains four Na sites followed by four Cl sites.
  let c = ",0.3,0.85,0.38";
  if (i % 8 < 4) { c = ",0.2,0.5,1.0"; }
  md.print(str(i) + "," + str(sim.x(i)) + "," + str(sim.y(i)) + "," + str(sim.z(i)) + c);
}
end _lmcode_
savedsl(compute, "build/visuals/nacl_structure-compute.dslb");
r = system ${dsl_cli(compute)} --dsl build/visuals/nacl_structure-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
write_file("build/visuals/nacl_structure.csv", split(r.stdout, "{\"ok\"")[0]);
draw = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.035, 0.055, 0.095);
scene.ambient(0.32);
scene.supersample(2);
scene.directional_light(-0.6, -1.0, -0.8, 0.85);
scene.fill_light(0.8, -0.1, 0.5, 0.45);
let rows = read_keyframes_csv("build/visuals/nacl_structure.csv");
for (i in range(0, rows.len())) {
  let p = rows.at(i);
  scene.sphere(0.085, material().color(p.r(), p.g(), p.b())).position(p.x(), p.y(), p.z());
}
scene.fit_camera(36.0, 1.24);
scene.render_png("docs/images/nacl_structure.png", 900, 560);
end _lmcode_
savedsl(draw, "build/visuals/nacl_structure-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/visuals/nacl_structure-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);


println("wrote docs/images/nacl_structure.png");
