# A seeded Langevin particle samples a three-dimensional harmonic external trap.
mkdir("build/visuals");
mkdir("docs/images");
sim_prog = _dsl_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
let sys = md.system()
  .add_particle(39.948, 0.25, 0.0, 0.0)
  .custom_external("0.5*k*(x^2+y^2+z^2)", "k=80.0");
let sim = sys.sim("langevin", 0.001, 300.0, 5.0, 2024);
sim.velocities(300.0, 2024);
for (i in range(0, 101)) {
  if (i == 0) { md.assert_close(sim.pe(), 2.5, 0.000001); }
  md.print(str(float(i) * 0.05) + "," + str(sim.ke()) + "," + str(sim.pe()) + "," + str(sim.temperature()));
  sim.step(50);
}
end _dsl_
savedsl(sim_prog, "build/visuals/thermal_trap-sim.dslb");
r = system ${dsl_cli(sim_prog)} --dsl build/visuals/thermal_trap-sim.dslb;
assert(r.code == 0);
write_file("build/visuals/thermal_trap.csv", "time_ps,kinetic_kj_mol,potential_kj_mol,temperature_k\n" + split(r.stdout, "{\"ok\"")[0]);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/thermal_trap.png", 900, 560);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Langevin sampling in a harmonic trap'; set xlabel 'Time (ps)'; set ylabel 'Energy (kJ/mol)'; set grid; set key top right");
plot.cmd("plot 'build/visuals/thermal_trap.csv' every ::1 using 1:2 with lines lw 2 lc rgb '#1f77b4' title 'kinetic', '' every ::1 using 1:3 with lines lw 2 lc rgb '#ff7f0e' title 'potential'");
plot.close();
end _dsl_
savedsl(draw, "build/visuals/thermal_trap-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/visuals/thermal_trap-draw.dslb;
assert(r.code == 0);

println("wrote docs/images/thermal_trap.png");
