# Run from any working directory: lmscript examples/visual/butane_relaxation.lms
# Molecular coordinates are computed by OpenMM, passed as CSV, then drawn by lmcad.
mkdir("build/visuals");
mkdir("docs/images");
compute = _lmcode_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
let pi = md.eval("pi");
let th0 = 109.47 * pi / 180.0;

# Construct a 4-carbon chain initially in a high-energy cis (eclipsed, phi = 0) geometry:
# C1(0, 0.154, 0) -- C2(0, 0, 0) -- C3(0.154, 0, 0) -- C4(0.154, 0.154, 0.02)
# For a trans minimum at phi = pi, use V(phi) = k * (1 + cos(3*phi - 0)):
# at phi = 0 (cis), cos(0) = 1 -> V = 2*k; at phi = pi (trans), cos(3*pi) = -1 -> V = 0.
let sys = md.system()
  .add_particle(15.035, 0.0, 0.154, 0.0)
  .add_particle(14.027, 0.0, 0.0, 0.0)
  .add_particle(14.027, 0.154, 0.0, 0.0)
  .add_particle(15.035, 0.154, -0.145, 0.05)
  .bond(0, 1, 0.154, 250000.0)
  .bond(1, 2, 0.154, 250000.0)
  .bond(2, 3, 0.154, 250000.0)
  .angle(0, 1, 2, th0, 520.0)
  .angle(1, 2, 3, th0, 520.0)
  .torsion(0, 1, 2, 3, 3, 0.0, 6.5)
  .lj(0.73, 0.39, 0.0)
  .exclude(0, 1)
  .exclude(1, 2)
  .exclude(2, 3)
  .exclude(0, 2)
  .exclude(1, 3);

let sim = sys.sim("verlet", 0.001, 0.0, 0.0, 1);
md.print("t,x,y,z,r,g,b");
for (state in range(0, 2)) {
  if (state == 1) { sim.minimize(0.00001, 500); }
  for (i in range(0, 4)) {
    let x = sim.x(i) + float(state) * 0.65;
    let color = ",0.95,0.5,0.16";
    if (state == 1) { color = ",0.15,0.8,0.72"; }
    md.print(str(state * 4 + i) + "," + str(x) + "," + str(sim.y(i)) + "," + str(sim.z(i)) + color);
  }
}
md.assert_close(sim.distance(0, 1), 0.154, 0.001);
end _lmcode_
savedsl(compute, "build/visuals/butane_relaxation-compute.dslb");
r = system ${dsl_cli(compute)} --lmcode build/visuals/butane_relaxation-compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
write_file("build/visuals/butane_relaxation.csv", split(r.stdout, "{\"ok\"")[0]);
draw = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.035, 0.055, 0.095);
scene.ambient(0.32);
scene.supersample(2);
scene.directional_light(-0.6, -1.0, -0.8, 0.85);
scene.fill_light(0.8, -0.1, 0.5, 0.45);
let rows = read_keyframes_csv("build/visuals/butane_relaxation.csv");
for (state in range(0, 2)) {
  for (i in range(0, 4)) {
    let p = rows.at(state * 4 + i);
    scene.sphere(0.045, material().color(p.r(), p.g(), p.b())).position(p.x(), p.y(), p.z());
    if (i < 3) {
      let q = rows.at(state * 4 + i + 1);
      for (j in range(1, 10)) {
        let t = float(j) / 10.0;
        scene.sphere(0.012, material().color(0.7, 0.75, 0.8)).position(lerp(p.x(), q.x(), t), lerp(p.y(), q.y(), t), lerp(p.z(), q.z(), t));
      }
    }
  }
}
scene.camera(35.0, 0.4, 0.55, 1.8, 0.4, 0.04, 0.0);
scene.render_png("docs/images/butane_relaxation.png", 900, 560);
end _lmcode_
savedsl(draw, "build/visuals/butane_relaxation-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/visuals/butane_relaxation-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);


println("wrote docs/images/butane_relaxation.png");
