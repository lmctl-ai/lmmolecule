# United-atom butane chain (4 CH2/CH3 sites): harmonic bonds, harmonic angles,
# 3-fold periodic torsion barrier, 1-2/1-3 nonbonded exclusions, and L-BFGS minimization.
mkdir("build/examples");
mkdir("docs/images");
out = ARGV.len() > 0 ? ARGV[0] : "build/butane_torsion.dslb";
p = _dsl_ cli="lmmolecule" install="github:lmctl-ai/lmmolecule@latest";
md.platform("reference");
let pi = md.eval("pi");
let th0 = 109.47 * pi / 180.0;

# Construct a 4-carbon chain initially in a high-energy cis (eclipsed, phi = 0) geometry:
# C1(0, 0.154, 0) -- C2(0, 0, 0) -- C3(0.154, 0, 0) -- C4(0.154, 0.154, 0.02)
# For a trans minimum at phi = pi, use V(phi) = k * (1 + cos(3*phi - 0)):
# at phi = 0 (cis), cos(0) = 1 -> V = 2*k; at phi = pi (trans), cos(3*pi) = -1 -> V = 0.
let sys = md.system()
  .add_particle(15.035, 0.0, 0.154, 0.0)
  .add_particle(14.027, 0.0, 0.0, 0.0)
  .add_particle(14.027, 0.154, 0.0, 0.0)
  .add_particle(15.035, 0.154, -0.145, 0.05)
  .bond(0, 1, 0.154, 250000.0)
  .bond(1, 2, 0.154, 250000.0)
  .bond(2, 3, 0.154, 250000.0)
  .angle(0, 1, 2, th0, 520.0)
  .angle(1, 2, 3, th0, 520.0)
  .torsion(0, 1, 2, 3, 3, 0.0, 6.5)
  .lj(0.73, 0.39, 0.0)
  .exclude(0, 1)
  .exclude(1, 2)
  .exclude(2, 3)
  .exclude(0, 2)
  .exclude(1, 3);

let sim = sys.sim("verlet", 0.001, 0.0, 0.0, 1);
let pe_before = sim.pe();
sim.report("build/examples/butane_before.csv", 1).step(0);
sim.minimize(0.00001, 500);
let pe_after = sim.pe();
sim.report("build/examples/butane_after.csv", 1).step(0);
md.print("Butane PE before/after minimization (kJ/mol): " + str(pe_before) + " -> " + str(pe_after));
# Bond lengths relax to 0.154 nm and C-C-C angles relax close to 109.47 deg (expanded slightly by 1-4 LJ).
md.assert_close(sim.distance(0, 1), 0.154, 0.001);
md.assert_close(sim.distance(1, 2), 0.154, 0.001);
md.assert_close(sim.distance(2, 3), 0.154, 0.001);
md.assert_close(sim.angle_val(0, 1, 2), th0, 0.03);
md.assert_close(sim.angle_val(1, 2, 3), th0, 0.03);
end _dsl_
savedsl(p, out);
# An explicit bytecode output argument retains compile-only use in test.sh.
if (ARGV.len() == 0) {
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0, r.stdout + r.stderr);

plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/butane_torsion.png", 900, 560);
plot.cmd("set title 'Butane torsion: energy before and after minimization'; set ylabel 'Potential energy (kJ/mol)'; set xrange [0:3]; set xtics ('before' 1, 'after' 2); set grid; set key off; set boxwidth 0.55; set style fill solid 0.75; set yrange [0:*]");
plot.cmd("plot 'build/examples/butane_before.csv' using (1):4 with boxes lc rgb '#9467bd', 'build/examples/butane_after.csv' using (2):4 with boxes lc rgb '#2ca02c'");
plot.close();
end _dsl_
savedsl(plot, "build/butane_torsion-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/butane_torsion-plot.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote docs/images/butane_torsion.png");

}
